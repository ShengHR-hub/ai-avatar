# ============================================================
# AI Avatar Studio V1.0 — 环境变量模板
# ------------------------------------------------------------
# 用途：V1.0 本地开发环境唯一的环境变量模板。
# 依据：docs/architecture/09-repository-boundary.md 第 6 节
#      docs/task-cards/ENG-00-engineering-foundation.md 步骤 3
#
# 使用：Copy-Item docker/.env.example .env.v1  后再启动 Compose。
#      本地实际配置文件固定为仓库根目录 .env.v1（已被 .gitignore 忽略，绝不提交）。
# 约定：本文件只含占位值，不得写入任何真实密码、Token 或 API Key；
#      非本地环境必须替换为真实密钥，且只能通过服务端环境注入，不写入仓库。
# 边界：服务端变量只注入 FastAPI / Worker / Beat；
#      任何服务端变量都不得改名为 NEXT_PUBLIC_*。
# ============================================================


# ============================================================
# 一、服务端变量（仅注入 FastAPI、Worker、Beat）
#     不得进入浏览器 bundle、OpenAPI、错误响应或普通日志
# ============================================================

# ── 应用 ────────────────────────────────────────────────────
# 运行环境标识：local | test | production
APP_ENV=local
# 对外基础地址，用于拼接分享链接等绝对地址
APP_BASE_URL=http://localhost:8000

# ── PostgreSQL（业务事实存储）───────────────────────────────
# 敏感：数据库连接串。值与 docker/compose.yml 的默认值逐项一致；驱动后缀由 ENG-01 最终确认。
DATABASE_URL=postgresql+psycopg://ai_avatar:placeholder@postgres:5432/ai_avatar

# ── Redis（Celery Broker、Session TTL、限流、短期锁）────────
# 不保存点数、任务最终状态或审计等持久业务事实
REDIS_URL=redis://redis:6379/0

# ── 对象存储（Storage Adapter）──────────────────────────────
# 驱动：local | minio | cos | oss | s3；本地 Compose 使用 minio
STORAGE_DRIVER=minio
STORAGE_ENDPOINT=http://minio:9000
STORAGE_BUCKET=ai-avatar
STORAGE_REGION=us-east-1
# 敏感：本地占位凭据，与下方 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD 保持一致
STORAGE_ACCESS_KEY=placeholder
STORAGE_SECRET_KEY=placeholder

# ── AI Provider ─────────────────────────────────────────────
# 本地默认 mock；切换真实供应商只改服务端变量，不修改业务代码
AI_PROVIDER=mock
# 以下三项仅在 AI_PROVIDER=QUANZIL 时填写；凭据不得进入前端或日志
AI_BASE_URL=
AI_MODEL=
# 敏感：AI_API_KEY
AI_API_KEY=

# ── 参考图片找灵感（图片理解）────────────────────────────────
# 与出图是两种能力、两个型号、两套计价：AI_VISION_MODEL 不复用 AI_MODEL。
# 真实供应商下三项缺一不可（缺任何一项都会在装配时响亮报错，绝不静默退回 Mock）：
# AI_BASE_URL / AI_API_KEY / AI_VISION_MODEL。
# 敏感：AI_VISION_MODEL 本身不是密钥，但它决定钱花在哪个型号上，只由服务端配置。
AI_VISION_MODEL=
# 能力开关。默认关闭：一次分析就是一次真实出网的付费调用。
# 注意它与 ENABLE_REFERENCE_IMAGE 无关——后者管的是把参考图当**生成条件**的
# REFERENCE_IMAGE 模式（上游能力未证实，继续关闭）。
ENABLE_IMAGE_ANALYSIS=false
# 付费闸门（按 UTC 日历日计，超限返回 429 RATE_LIMITED）。
# 默认值是最坏情况的支出上限，不是容量规划：请按型号实际单价复核后再放大。
ANALYSIS_DAILY_LIMIT_PER_USER=10
ANALYSIS_GLOBAL_DAILY_LIMIT=50

# ── 安全 ────────────────────────────────────────────────────
# 敏感：会话 Cookie 签名密钥。本地占位值为 placeholder；
# 任何非本地环境必须替换，生成方式：
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=placeholder

# ── 功能开关 ────────────────────────────────────────────────
# 参考图模式：第一阶段默认关闭；关闭时明确返回 FEATURE_NOT_AVAILABLE
# 这里只管 REFERENCE_IMAGE「生成模式」。读参考图找灵感的能力开关是
# ENABLE_IMAGE_ANALYSIS（见上面「参考图片找灵感」一节），两者互不牵连：
# 打开分析不会放开未证实的参考图生成，反之亦然。
ENABLE_REFERENCE_IMAGE=false


# ============================================================
# 二、Compose / 基础设施变量
#     只供 docker compose 与 postgres、minio 容器使用；
#     不得映射为 NEXT_PUBLIC_*，前端容器不得读取
# ============================================================

# ── PostgreSQL 初始化 ───────────────────────────────────────
POSTGRES_DB=ai_avatar
POSTGRES_USER=ai_avatar
# 敏感：本地占位密码，仅用于本机开发，必须与 DATABASE_URL 中的密码一致
POSTGRES_PASSWORD=placeholder

# ── MinIO 初始化 ────────────────────────────────────────────
MINIO_ROOT_USER=placeholder
MINIO_ROOT_PASSWORD=placeholder


# ============================================================
# 三、前端变量
#     只有 NEXT_PUBLIC_* 会进入浏览器 bundle；API_PROXY_TARGET 只在
#     Next 服务端进程使用，绝不允许改名为 NEXT_PUBLIC_*
# ============================================================

# 浏览器调用 API 的基址。**保持相对同源**：浏览器请求当前站点自己的 /api/v1，
# 由 Next 服务端的同源代理转发到 API_PROXY_TARGET。
# 构建期会被内联进浏览器 bundle，因此这里不能写容器内主机名或宿主端口。
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Next 服务端转发 /api/v1/** 的目标（同源代理）。
# Compose 内部用服务名：http://backend:8000。
# 宿主机上直接跑 `next start` 时改成 http://127.0.0.1:8100 之类的可达地址。
# 该值在**构建期**写入 routes-manifest.json，修改后必须重新 `next build`。
API_PROXY_TARGET=http://backend:8000
