      "UploadIntent": { "type": "object", "required": ["purpose", "filename", "mime_type", "size_bytes", "sha256"], "properties": { "purpose": { "type": "string", "enum": ["SOURCE", "REFERENCE"] }, "filename": { "type": "string", "maxLength": 255 }, "mime_type": { "type": "string" }, "size_bytes": { "type": "integer", "minimum": 1 }, "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" } }, "additionalProperties": false },
