      "PageEnvelope": { "type": "object", "required": ["data", "page", "request_id"], "properties": { "data": { "type": "array", "items": {} }, "page": { "type": "object", "required": ["next_cursor", "has_more"], "properties": { "next_cursor": { "type": ["string", "null"] }, "has_more": { "type": "boolean" } } }, "request_id": { "type": "string" } } }
