      "ReferenceDescriptionRequest": { "type": "object", "required": ["asset_id"], "properties": { "asset_id": { "type": "string", "format": "uuid" } }, "additionalProperties": false },
      "ShareCreateRequest": { "type": "object", "required": ["generation_id", "output_asset_ids"], "properties": { "generation_id": { "type": "string", "format": "uuid" }, "output_asset_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } }, "title": { "type": ["string", "null"], "maxLength": 160 } }, "additionalProperties": false },
      "FeedbackCreateRequest": { "type": "object", "required": ["generation_id", "rating", "category"], "properties": { "generation_id": { "type": "string", "format": "uuid" }, "rating": { "type": "integer", "minimum": 1, "maximum": 5 }, "category": { "type": "string", "maxLength": 64 }, "content": { "type": ["string", "null"], "maxLength": 2000 } }, "additionalProperties": false },
      "GenerationEnvelope": { "allOf": [{ "$ref": "#/components/schemas/Envelope" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Generation" } } }] },
